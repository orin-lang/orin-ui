import { assert, assertEq, assertEqString, assertEqual } from "std:test";
import { Dom, dElement, dKeyed, dText, domAttr, dumpDom } from "../src";
import { Patch, Create, Remove, Replace, SetAttr, RemoveAttr, SetText, Move, diff, apply } from "../src";

function li(key: string, text: string): Dom {
  return dKeyed("li", key, [], [dText(text)]);
}

function checkRoundTrip(name: string, a: Dom[], b: Dom[]): Patch[] {
  const patches = diff(a, b);
  match (apply(a, patches)) {
    Ok(t) => { assertEqString(dumpDom(t), dumpDom(b), name); },
    Err(e) => { assert(false, name + ": " + e); },
  }
  return patches;
}

@Test
function identicalTreesGiveNoPatches(): void {
  const t = [dElement("div", [domAttr("class", "a")], [dText("x"), dElement("b", [], [])])];
  assertEq(diff(t, t).length.toInt(), 0, "no patches");
}

@Test
function textChangeIsSetText(): void {
  const ps = checkRoundTrip("text", [dElement("p", [], [dText("a")])], [dElement("p", [], [dText("b")])]);
  assertEqual(ps, [SetText([0, 0], "b")], "SetText");
}

@Test
function attributeChanges(): void {
  const a = [dElement("a", [domAttr("href", "/1"), domAttr("class", "x")], [])];
  const b = [dElement("a", [domAttr("href", "/2"), domAttr("title", "t")], [])];
  const ps = checkRoundTrip("attrs", a, b);
  assertEqual(ps, [RemoveAttr([0], "class"), SetAttr([0], "href", "/2"), SetAttr([0], "title", "t")], "attr patches");
}

@Test
function differentTagIsReplace(): void {
  const ps = checkRoundTrip("tag", [dElement("div", [], [dText("a")])], [dElement("span", [], [dText("a")])]);
  assertEqual(ps, [Replace([0], dElement("span", [], [dText("a")]))], "Replace");
  const ps2 = checkRoundTrip("kind", [dText("a")], [dElement("i", [], [])]);
  assertEqual(ps2, [Replace([0], dElement("i", [], []))], "text to element");
}

@Test
function unkeyedChildrenAreMatchedByPosition(): void {
  const a = [dElement("ul", [], [dElement("li", [], [dText("1")]), dElement("li", [], [dText("2")])])];
  const b = [dElement("ul", [], [dElement("li", [], [dText("1")]), dElement("li", [], [dText("2")]), dElement("li", [], [dText("3")])])];
  const ps = checkRoundTrip("append", a, b);
  assertEqual(ps, [Create([0, 2], dElement("li", [], [dText("3")]))], "append");
  const ps2 = checkRoundTrip("truncate", b, a);
  assertEqual(ps2, [Remove([0, 2])], "truncate");
  const c = [dElement("ul", [], [dElement("li", [], [dText("2")])])];
  const ps3 = checkRoundTrip("shift", a, c);
  assertEqual(ps3, [Remove([0, 1]), SetText([0, 0, 0], "2")], "unkeyed removal of the first reuses the slot");
}

@Test
function keyedInsertInTheMiddle(): void {
  const a = [dElement("ul", [], [li("a", "A"), li("c", "C")])];
  const b = [dElement("ul", [], [li("a", "A"), li("b", "B"), li("c", "C")])];
  const ps = checkRoundTrip("insert", a, b);
  assertEqual(ps, [Create([0, 1], li("b", "B"))], "one Create, nothing else touched");
}

@Test
function keyedRemoveFromTheFront(): void {
  const a = [dElement("ul", [], [li("a", "A"), li("b", "B"), li("c", "C")])];
  const b = [dElement("ul", [], [li("b", "B"), li("c", "C")])];
  const ps = checkRoundTrip("remove", a, b);
  assertEqual(ps, [Remove([0, 0])], "one Remove");
}

@Test
function keyedMoveToTheEndIsOneMove(): void {
  const a = [dElement("ul", [], [li("a", "A"), li("b", "B"), li("c", "C"), li("d", "D")])];
  const b = [dElement("ul", [], [li("b", "B"), li("c", "C"), li("d", "D"), li("a", "A")])];
  const ps = checkRoundTrip("rotate", a, b);
  assertEqual(ps, [Move([0], 0, 3)], "a single Move");
}

@Test
function keyedSwapAndReverse(): void {
  const a = [dElement("ul", [], [li("a", "A"), li("b", "B"), li("c", "C")])];
  const b = [dElement("ul", [], [li("c", "C"), li("b", "B"), li("a", "A")])];
  const ps = checkRoundTrip("reverse", a, b);
  assertEq(ps.length.toInt(), 2, "reversing three items moves two");
  const ps2 = checkRoundTrip("back", b, a);
  assertEq(ps2.length.toInt(), 2, "and back");
}

@Test
function keyedChildKeepsItsStateWhenMoved(): void {
  // The moved item's own change is a SetText at its final index, not a re-create.
  const a = [dElement("ul", [], [li("a", "A"), li("b", "B")])];
  const b = [dElement("ul", [], [li("b", "B2"), li("a", "A")])];
  const ps = checkRoundTrip("move and edit", a, b);
  assertEqual(ps, [Move([0], 1, 0), SetText([0, 0, 0], "B2")], "move then edit");
}

@Test
function keyedMixedOperations(): void {
  const a = [dElement("ul", [], [li("a", "A"), li("b", "B"), li("c", "C"), li("d", "D"), li("e", "E")])];
  const b = [dElement("ul", [], [li("e", "E"), li("x", "X"), li("b", "B"), li("a", "A2"), li("y", "Y")])];
  checkRoundTrip("mixed", a, b);
  checkRoundTrip("mixed back", b, a);
}

@Test
function duplicateKeysDoNotCorrupt(): void {
  const a = [dElement("ul", [], [li("a", "1"), li("a", "2"), li("b", "3")])];
  const b = [dElement("ul", [], [li("b", "3"), li("a", "2"), li("a", "1")])];
  checkRoundTrip("duplicates", a, b);
  checkRoundTrip("duplicates back", b, a);
}

@Test
function keyedAndUnkeyedMixed(): void {
  const a = [dElement("div", [], [dElement("h1", [], [dText("T")]), li("a", "A"), li("b", "B")])];
  const b = [dElement("div", [], [dElement("h1", [], [dText("T2")]), li("b", "B"), li("a", "A"), dText("tail")])];
  checkRoundTrip("mixed keyed and unkeyed", a, b);
}

@Test
function rootListChanges(): void {
  checkRoundTrip("empty to some", [], [dText("a"), dElement("p", [], [])]);
  checkRoundTrip("some to empty", [dText("a"), dElement("p", [], [])], []);
}

@Test
function nestedChangesUseFullPaths(): void {
  const a = [dElement("div", [], [dElement("p", [], [dText("x")]), dElement("p", [], [dElement("b", [], [dText("y")])])])];
  const b = [dElement("div", [], [dElement("p", [], [dText("x")]), dElement("p", [], [dElement("b", [domAttr("id", "q")], [dText("z")])])])];
  const ps = checkRoundTrip("nested", a, b);
  assertEqual(ps, [SetAttr([0, 1, 0], "id", "q"), SetText([0, 1, 0, 0], "z")], "paths");
}

// A small deterministic generator for the property test.
function next(seed: int): int {
  return (seed * 1103515245 + 12345) % 2147483648;
}

function randomList(seed: int, size: int): Dom[] {
  // a random subset of keys "k0".."k7" in a random order, each with one of two texts
  let s = seed;
  let out: Dom[] = [];
  let used: bool[] = [false, false, false, false, false, false, false, false];
  let i = 0;
  while (i < size) {
    s = next(s);
    const k = (s / 7) % 8;
    s = next(s);
    const t = (s / 5) % 2;
    if (!used[k.toUsize()]) {
      used[k.toUsize()] = true;
      out.push(li("k" + k.toString(), "t" + t.toString()));
    }
    i += 1;
  }
  return out;
}

@Test
function randomKeyedListsRoundTrip(): void {
  let seed = 42;
  let n = 0;
  while (n < 300) {
    seed = next(seed);
    const a = randomList(seed, (seed / 11) % 9);
    seed = next(seed);
    const b = randomList(seed, (seed / 13) % 9);
    checkRoundTrip("random " + n.toString(), [dElement("ul", [], a)], [dElement("ul", [], b)]);
    n += 1;
  }
}

@Test
function randomListsAreMinimalForSingleMoves(): void {
  // moving one item anywhere in a list of 8 is one Move
  let src = 0;
  while (src < 8) {
    let to = 0;
    while (to < 8) {
      if (src != to) {
        let keys: string[] = [];
        let i = 0;
        while (i < 8) { keys.push("k" + i.toString()); i += 1; }
        const moved = keys[src.toUsize()];
        const without = keys.filter(k => k != moved);
        const target = without.slice(0, to.toUsize()).concat([moved]).concat(without.slice(to.toUsize(), without.length));
        const a = [dElement("ul", [], keys.map(k => li(k, k)))];
        const b = [dElement("ul", [], target.map(k => li(k, k)))];
        const ps = checkRoundTrip("single move", a, b);
        assertEq(ps.length.toInt(), 1, "one op for a single move " + src.toString() + "->" + to.toString());
      }
      to += 1;
    }
    src += 1;
  }
}
