import { assertEqString, assertEqual, assert, assertEq } from "std:test";
import {
  Node, Program, Session, el, text, div, button, input, onClick, onInput, cls, attr, key, value, when, mapMsg,
  resolve, toDom, messageAt, start, send, sendAll, handleEvent, respond, mountReply, sessionOf,
  renderHtml, renderText, patchesText, ClientEvent, SetText, Remove, Create, dText, dElement,
  HtmlRenderer, PatchStreamRenderer, TextRenderer, Renderer
} from "../src";

type Model = { count: int; note: string; };
type Msg = Increment | Decrement | Reset | SetNote(string);

function update(m: Model, msg: Msg): Model {
  return match (msg) {
    Increment => Model { ...m, count: m.count + 1 },
    Decrement => Model { ...m, count: m.count - 1 },
    Reset => Model { ...m, count: 0 },
    SetNote(s) => Model { ...m, note: s },
  };
}

function view(m: Model): Node<Msg> {
  return div([cls("counter")], [
    button([onClick(Decrement)], [text("-")]),
    el("span", [cls("value")], [text(m.count.toString())]),
    button([onClick(Increment)], [text("+")]),
    input([attr("type", "text"), value(m.note), onInput((v: string): Msg => SetNote(v))]),
    when(m.count > 2, el("b", [], [text("big")])),
  ]);
}

function program(): Program<Model, Msg> {
  return Program<Model, Msg> { init: Model { count: 0, note: "" }, update: update, view: view };
}

@Test
function startRendersTheInitialModel(): void {
  const s = start(program());
  assertEqString(renderHtml(s.dom), "<div class=\"counter\"><button data-ou-on=\"click\">-</button><span class=\"value\">0</span><button data-ou-on=\"click\">+</button><input type=\"text\" value=\"\" data-ou-on=\"input\"></div>", "html");
}

@Test
function sendProducesTheMinimalPatch(): void {
  const s = start(program());
  const step = send(program(), s, Increment);
  assertEq(step.session.model.count, 1, "model");
  assertEqual(step.patches, [SetText([0, 1, 0], "1")], "one text patch");
  assert(step.handled, "handled");
}


@Test
function conditionalChildrenAreCreatedAndRemoved(): void {
  const p = program();
  let s = start(p);
  s = send(p, s, Increment).session;
  s = send(p, s, Increment).session;
  const up = send(p, s, Increment);
  assertEqual(up.patches, [Create([0, 4], dElement("b", [], [dText("big")])), SetText([0, 1, 0], "3")], "create the conditional child, then update the number");
  const down = send(p, up.session, Reset);
  assertEqual(down.patches, [Remove([0, 4]), SetText([0, 1, 0], "0")], "remove it again");
}


@Test
function eventsRouteBackToTypedMessages(): void {
  const p = program();
  const s = start(p);
  // the "+" button is the third child of the root div
  const inc = handleEvent(p, s, ClientEvent { path: [0, 2], event: "click", value: "" });
  assert(inc.handled, "handled");
  assertEq(inc.session.model.count, 1, "Increment");
  const dec = handleEvent(p, s, ClientEvent { path: [0, 0], event: "click", value: "" });
  assertEq(dec.session.model.count, -1, "Decrement");
  // a value event maps its payload to a message
  const typed = handleEvent(p, s, ClientEvent { path: [0, 3], event: "input", value: "hello" });
  assertEqString(typed.session.model.note, "hello", "SetNote");
  assertEqual(typed.patches.length.toInt(), 1, "one patch for the value");
}

@Test
function unroutableEventsAreIgnored(): void {
  const p = program();
  const s = start(p);
  const wrongEvent = handleEvent(p, s, ClientEvent { path: [0, 2], event: "dblclick", value: "" });
  assert(!wrongEvent.handled, "event the element does not handle");
  assertEq(wrongEvent.patches.length.toInt(), 0, "no patches");
  assert(!handleEvent(p, s, ClientEvent { path: [0, 1], event: "click", value: "" }).handled, "element without handlers");
  assert(!handleEvent(p, s, ClientEvent { path: [0, 1, 0], event: "click", value: "" }).handled, "text node");
  assert(!handleEvent(p, s, ClientEvent { path: [9], event: "click", value: "" }).handled, "no such node");
  assert(!handleEvent(p, s, ClientEvent { path: [], event: "click", value: "" }).handled, "empty path");
  assert(!handleEvent(p, s, ClientEvent { path: [-1], event: "click", value: "" }).handled, "negative index");
}

@Test
function sendAllAppliesMessagesInOrder(): void {
  const p = program();
  const step = sendAll(p, start(p), [Increment, Increment, Decrement, Increment]);
  assertEq(step.session.model.count, 2, "count");
  assertEqual(step.patches, [SetText([0, 1, 0], "2")], "one patch from the first screen to the last");
}

@Test
function respondHandlesTheWholeRequest(): void {
  const p = program();
  const s = start(p);
  const r = respond(p, s, "{\"t\":\"event\",\"path\":[0,2],\"event\":\"click\",\"value\":\"\"}");
  assertEqString(r.body, "{\"t\":\"patch\",\"ops\":[{\"op\":\"text\",\"path\":[0,1,0],\"text\":\"1\"}]}", "patch message");
  assertEq(r.session.model.count, 1, "new session");
  const j = respond(p, r.session, "{\"t\":\"join\"}");
  assert(j.body.startsWith("{\"t\":\"mount\""), "join gets a mount");
  assert(j.body.includes("\"1\""), "of the current model");
  const bad = respond(p, s, "garbage");
  assert(bad.error.length > 0, "error reported");
  assertEq(bad.session.model.count, 0, "session unchanged");
  assertEqString(bad.body, "{\"t\":\"patch\",\"ops\":[]}", "empty patch");
}

@Test
function sessionsAreValues(): void {
  const p = program();
  const s0 = start(p);
  const s1 = send(p, s0, Increment).session;
  assertEq(s0.model.count, 0, "the old session is untouched");
  assertEq(s1.model.count, 1, "the new one moved on");
  // a branch from the old session is independent
  const s2 = send(p, s0, Decrement).session;
  assertEq(s2.model.count, -1, "branch");
  assertEq(s1.model.count, 1, "other branch");
}

// ---- composition: a child with its own model and message type, embedded with mapMsg

type ChildMsg = Bump | Idle;
type ParentMsg = Left(ChildMsg) | Right(ChildMsg);
type Pair = { left: int; right: int; };

function childView(n: int): Node<ChildMsg> {
  return button([onClick(Bump)], [text(n.toString())]);
}

function pairView(m: Pair): Node<ParentMsg> {
  return div([], [
    mapMsg(childView(m.left), (c: ChildMsg): ParentMsg => Left(c)),
    mapMsg(childView(m.right), (c: ChildMsg): ParentMsg => Right(c)),
  ]);
}

function pairUpdate(m: Pair, msg: ParentMsg): Pair {
  return match (msg) {
    Left(c) => Pair { ...m, left: m.left + 1 },
    Right(c) => Pair { ...m, right: m.right + 10 },
  };
}

@Test
function mapMsgEmbedsAChildComponent(): void {
  const p = Program<Pair, ParentMsg> { init: Pair { left: 0, right: 0 }, update: pairUpdate, view: pairView };
  let s = start(p);
  s = handleEvent(p, s, ClientEvent { path: [0, 0], event: "click", value: "" }).session;
  s = handleEvent(p, s, ClientEvent { path: [0, 1], event: "click", value: "" }).session;
  s = handleEvent(p, s, ClientEvent { path: [0, 1], event: "click", value: "" }).session;
  assertEqString(renderText(s.dom), "div\n  button [click]\n    \"1\"\n  button [click]\n    \"20\"", "both children updated");
}

// ---- keyed lists keep identity

type ListMsg = Remove2(string) | Rotate;
type Items = { ids: string[]; };

function itemsView(m: Items): Node<ListMsg> {
  return el("ul", [], m.ids.map(id => el("li", [key(id), onClick(Remove2(id))], [text(id)])));
}

function itemsUpdate(m: Items, msg: ListMsg): Items {
  return match (msg) {
    Remove2(id) => Items { ids: m.ids.filter(x => x != id) },
    Rotate => Items { ids: m.ids.slice(1, m.ids.length).concat(m.ids.slice(0, 1)) },
  };
}

@Test
function keyedViewsProduceMoves(): void {
  const p = Program<Items, ListMsg> { init: Items { ids: ["a", "b", "c", "d"] }, update: itemsUpdate, view: itemsView };
  const s = start(p);
  const rot = send(p, s, Rotate);
  assertEqString(patchesText(rot.patches), "move /0 0 -> 3", "one move");
  const del = send(p, s, Remove2("b"));
  assertEqString(patchesText(del.patches), "remove /0/1", "one removal");
  // routing follows the current positions
  const after = handleEvent(p, del.session, ClientEvent { path: [0, 1], event: "click", value: "" });
  assertEqString(renderText(after.session.dom), "ul\n  li [click]\n    \"a\"\n  li [click]\n    \"d\"", "c was at index 1 after b went away");
}

// ---- backends behind one interface

function describe(r: Renderer, roots: Node<Msg>): string {
  const dom = toDom<Msg>(resolve<Msg>(roots));
  return r.name() + ": " + r.mount(dom);
}

@Test
function threeBackendsOneInterface(): void {
  const n = el<Msg>("p", [cls("x")], [text("a<b")]);
  assertEqString(describe(new HtmlRenderer(), n), "html: <p class=\"x\">a&lt;b</p>", "html");
  assertEqString(describe(new PatchStreamRenderer(), n), "patch-stream: {\"t\":\"mount\",\"dom\":[{\"t\":\"p\",\"a\":[[\"class\",\"x\"]],\"c\":[\"a<b\"]}]}".split("<").join("\\u003c"), "patch stream");
  assertEqString(describe(new TextRenderer(), n), "text: p.x\n  \"a<b\"", "text");
  const before = [dText("a")];
  const after = [dText("b")];
  const patches = [SetText([0], "b")];
  assertEqString(new HtmlRenderer().update(before, after, patches), "b", "html update re-renders");
  assertEqString(new PatchStreamRenderer().update(before, after, patches), "{\"t\":\"patch\",\"ops\":[{\"op\":\"text\",\"path\":[0],\"text\":\"b\"}]}", "patch update");
  assertEqString(new TextRenderer().update(before, after, patches), "text /0 \"b\"", "text update");
}
