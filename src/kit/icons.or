// Icons: 24x24 stroke icons as inline SVG, so they take the colour of the text around them (`currentColor`) and need no files.
import { Node, attr, cls, el } from "../tree";

// The path data of an icon; "" for an unknown name.
export function iconPath(name: string): string {
  return match (name) {
    "overview" => "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z",
    "apps" => "M21 8l-9-5-9 5v8l9 5 9-5V8z M3 8l9 5 9-5 M12 13v8",
    "runs" => "M3 12h4l3-8 4 16 3-8h4",
    "logs" => "M4 6h16 M4 12h16 M4 18h10",
    "queues" => "M12 2l10 5-10 5L2 7l10-5z M2 17l10 5 10-5 M2 12l10 5 10-5",
    "kv" => "M12 3c4.97 0 9 1.34 9 3s-4.03 3-9 3-9-1.34-9-3 4.03-3 9-3z M3 6v6c0 1.66 4.03 3 9 3s9-1.34 9-3V6 M3 12v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6",
    "settings" => "M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6",
    "search" => "M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35",
    "sun" => "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z M12 1v2 M12 21v2 M4.22 4.22l1.42 1.42 M18.36 18.36l1.42 1.42 M1 12h2 M21 12h2 M4.22 19.78l1.42-1.42 M18.36 5.64l1.42-1.42",
    "moon" => "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z",
    "chevron-right" => "M9 6l6 6-6 6",
    "chevron-down" => "M6 9l6 6 6-6",
    "arrow-up" => "M12 19V5 M5 12l7-7 7 7",
    "arrow-down" => "M12 5v14 M19 12l-7 7-7-7",
    "plus" => "M12 5v14 M5 12h14",
    "x" => "M18 6L6 18 M6 6l12 12",
    "check" => "M20 6L9 17l-5-5",
    "alert" => "M12 9v4 M12 17h.01 M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z",
    "info" => "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01",
    "refresh" => "M23 4v6h-6 M1 20v-6h6 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15",
    "trash" => "M3 6h18 M8 6V4h8v2 M19 6l-1 14H6L5 6 M10 11v6 M14 11v6",
    "play" => "M5 3l14 9-14 9V3z",
    "pause" => "M6 4h4v16H6z M14 4h4v16h-4z",
    "user" => "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
    "log-out" => "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9",
    "menu" => "M3 12h18 M3 6h18 M3 18h18",
    "server" => "M2 3h20v8H2z M2 13h20v8H2z M6 7h.01 M6 17h.01",
    "external" => "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3",
    "copy" => "M9 9h11v11H9z M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1",
    "clock" => "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2",
    _ => "",
  };
}

// Icon(name) -- the icon as an `svg` element, 16px by default (`ou-icon`), hidden from screen readers (it decorates a label).
export function Icon<M>(name: string): Node<M> {
  return el<M>(
    "svg",
    [
      cls<M>("ou-icon"),
      attr<M>("viewBox", "0 0 24 24"),
      attr<M>("fill", "none"),
      attr<M>("stroke", "currentColor"),
      attr<M>("stroke-width", "2"),
      attr<M>("stroke-linecap", "round"),
      attr<M>("stroke-linejoin", "round"),
      attr<M>("aria-hidden", "true"),
      attr<M>("focusable", "false"),
    ],
    [el<M>("path", [attr<M>("d", iconPath(name))], [])],
  );
}
