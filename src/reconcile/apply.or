// The reference implementation of the patch operations on a Dom value. Renderers with state (a terminal, a test double)
// can use it to keep a mirror of what they show; the tests use it to check that `diff` is correct:
// `apply(old, diff(old, next)) == next` for every pair of trees.
import { Dom, DomAttr, DElement, DText } from "../tree";
import { Patch, Create, Remove, Replace, SetAttr, RemoveAttr, SetText, Move } from "./diff";

// apply(roots, patches) -- the tree after the patches, or an error naming the first patch that does not fit.
export function apply(roots: Dom[], patches: Patch[]): Result<Dom[], string> {
  let tree = roots;
  let n = 0;
  for (const p of patches) {
    match (applyOne(tree, p)) {
      Ok(t) => {
        tree = t;
      },
      Err(e) => {
        return Err("patch " + n.toString() + ": " + e);
      },
    }
    n += 1;
  }
  return Ok(tree);
}

function applyOne(roots: Dom[], p: Patch): Result<Dom[], string> {
  return match (p) {
    Create(path, node) => insertChild(roots, path, node),
    Remove(path) => removeChild(roots, path),
    Replace(path, node) => editNode(roots, path, (old: Dom): Result<Dom[], string> => Ok([node])),
    SetAttr(path, name, value) => editNode(
      roots,
      path,
      (old: Dom): Result<Dom[], string> => setAttribute(old, name, value),
    ),
    RemoveAttr(path, name) => editNode(
      roots,
      path,
      (old: Dom): Result<Dom[], string> => removeAttribute(old, name),
    ),
    SetText(path, text) => editNode(
      roots,
      path,
      (old: Dom): Result<Dom[], string> => setTextOf(old, text),
    ),
    Move(parent, fromIdx, to) => moveChild(roots, parent, fromIdx, to),
  };
}

function setAttribute(old: Dom, name: string, value: string): Result<Dom[], string> {
  return match (old) {
    DText(s) => Err("SetAttr on a text node"),
    DElement(t, k, attrs, cs) => Ok([DElement(t, k, withAttr(attrs, name, value), cs)]),
  };
}

function withAttr(attrs: DomAttr[], name: string, value: string): DomAttr[] {
  let out: DomAttr[] = [];
  let found = false;
  for (const a of attrs) {
    if (a.name == name) {
      out.push(DomAttr { name: name, value: value });
      found = true;
    } else {
      out.push(a);
    }
  }
  if (!found) {
    out.push(DomAttr { name: name, value: value });
  }
  return out;
}

function removeAttribute(old: Dom, name: string): Result<Dom[], string> {
  return match (old) {
    DText(s) => Err("RemoveAttr on a text node"),
    DElement(t, k, attrs, cs) => Ok([DElement(t, k, attrs.filter(a => a.name != name), cs)]),
  };
}

function setTextOf(old: Dom, text: string): Result<Dom[], string> {
  return match (old) {
    DText(s) => Ok([DText(text)]),
    DElement(t, k, attrs, cs) => Err("SetText on an element"),
  };
}

// Run `edit` on the node at `path`; the nodes it returns replace it.
function editNode(
  roots: Dom[],
  path: int[],
  edit: (old: Dom) => Result<Dom[], string>,
): Result<Dom[], string> {
  if (path.length == 0) {
    return Err("empty path");
  }
  const idx = path[0];
  if (idx < 0 || idx >= roots.length.toInt()) {
    return Err("no node at index " + idx.toString());
  }
  const i = idx.toUsize();
  const rest = path.slice(1, path.length);
  if (rest.length == 0) {
    const replaced = edit(roots[i])?;
    return Ok(roots.slice(0, i).concat(replaced).concat(roots.slice(i + 1, roots.length)));
  }
  return match (roots[i]) {
    DText(s) => Err("path goes through a text node"),
    DElement(t, k, attrs, cs) => withChildren(roots, i, t, k, attrs, editNode(cs, rest, edit)),
  };
}

function withChildren(
  roots: Dom[],
  i: usize,
  t: string,
  k: Option<string>,
  attrs: DomAttr[],
  cs: Result<Dom[], string>,
): Result<Dom[], string> {
  const children = cs?;
  return Ok(
    roots
        .slice(0, i)
        .concat([DElement(t, k, attrs, children)])
        .concat(roots.slice(i + 1, roots.length)),
  );
}

// Apply `f` to the child list of the node at `parent` (the root list when `parent` is empty).
function editChildren(
  roots: Dom[],
  parent: int[],
  f: (children: Dom[]) => Result<Dom[], string>,
): Result<Dom[], string> {
  if (parent.length == 0) {
    return f(roots);
  }
  return editNode(
    roots,
    parent,
    (old: Dom): Result<Dom[], string> => match (old) {
      DText(s) => Err("path goes through a text node"),
      DElement(t, k, attrs, cs) => withChildList(t, k, attrs, f(cs)),
    },
  );
}

function withChildList(
  t: string,
  k: Option<string>,
  attrs: DomAttr[],
  cs: Result<Dom[], string>,
): Result<Dom[], string> {
  const children = cs?;
  return Ok([DElement(t, k, attrs, children)]);
}

function insertChild(roots: Dom[], path: int[], node: Dom): Result<Dom[], string> {
  if (path.length == 0) {
    return Err("empty path");
  }
  const last = path[path.length - 1];
  const parent = path.slice(0, path.length - 1);
  return editChildren(
    roots,
    parent,
    (cs: Dom[]): Result<Dom[], string> => {
      if (last < 0 || last > cs.length.toInt()) {
        return Err("cannot insert at index " + last.toString());
      }
      const i = last.toUsize();
      return Ok(cs.slice(0, i).concat([node]).concat(cs.slice(i, cs.length)));
    },
  );
}

function removeChild(roots: Dom[], path: int[]): Result<Dom[], string> {
  if (path.length == 0) {
    return Err("empty path");
  }
  const last = path[path.length - 1];
  const parent = path.slice(0, path.length - 1);
  return editChildren(
    roots,
    parent,
    (cs: Dom[]): Result<Dom[], string> => {
      if (last < 0 || last >= cs.length.toInt()) {
        return Err("no node at index " + last.toString());
      }
      const i = last.toUsize();
      return Ok(cs.slice(0, i).concat(cs.slice(i + 1, cs.length)));
    },
  );
}

function moveChild(roots: Dom[], parent: int[], fromIdx: int, to: int): Result<Dom[], string> {
  return editChildren(
    roots,
    parent,
    (cs: Dom[]): Result<Dom[], string> => {
      if (fromIdx < 0 || fromIdx >= cs.length.toInt() || to < 0 || to >= cs.length.toInt()) {
        return Err("move out of range");
      }
      const f = fromIdx.toUsize();
      const moving = cs[f];
      const rest = cs.slice(0, f).concat(cs.slice(f + 1, cs.length));
      const t = to.toUsize();
      return Ok(rest.slice(0, t).concat([moving]).concat(rest.slice(t, rest.length)));
    },
  );
}
