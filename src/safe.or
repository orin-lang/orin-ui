// Safety rules shared by the view lowering and the HTML renderer.
//
// A UI tree is data a program computes, often from user input. These rules keep that data from becoming code:
//   * tag and attribute names must be plain ASCII names (no quotes, spaces, `=` or `>` that could break out of a tag);
//   * attributes named `on...` are refused (an event handler is a typed message, never a string of JavaScript);
//   * `srcdoc` is refused (it is HTML), `script` elements and a few document-level elements are refused;
//   * URL attributes (`href`, `src`, ...) go through `std:html`'s `safeUrl`: `javascript:` and similar become a constant.
import { safeUrl } from "std:html";

// ASCII lower-casing (the other bytes are copied).
export function asciiLower(s: string): string {
  let out = "";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      out += String.fromCharCode(c + 32);
    } else {
      out += s.substring(i, i + 1);
    }
    i += 1;
  }
  return out;
}

function isAlpha(c: int): bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

function isDigit(c: int): bool {
  return c >= 48 && c <= 57;
}

// A tag name: a letter, then letters, digits and `-`; at most 64 bytes. (Custom elements such as `my-widget` pass.)
export function isValidTag(t: string): bool {
  if (t.length == 0 || t.length > 64) {
    return false;
  }
  if (!isAlpha(t.charCodeAt(0))) {
    return false;
  }
  let i: usize = 1;
  while (i < t.length) {
    const c = t.charCodeAt(i);
    if (!(isAlpha(c) || isDigit(c) || c == 45)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Elements the renderers never produce.
export function isForbiddenTag(t: string): bool {
  const l = asciiLower(t);
  return l == "script" || l == "base" || l == "meta" || l == "object" || l == "embed" || l == "applet";
}

// An attribute name: a letter, `_` or `:`, then letters, digits, `_`, `:`, `.` and `-`; at most 64 bytes.
export function isValidAttrName(n: string): bool {
  if (n.length == 0 || n.length > 64) {
    return false;
  }
  const first = n.charCodeAt(0);
  if (!(isAlpha(first) || first == 95 || first == 58)) {
    return false;
  }
  let i: usize = 1;
  while (i < n.length) {
    const c = n.charCodeAt(i);
    if (!(isAlpha(c) || isDigit(c) || c == 95 || c == 58 || c == 46 || c == 45)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// May an attribute with this name be put in a tree? Event handlers (`on*`), `srcdoc` and the reserved events attribute are not.
export function isAllowedAttr(name: string): bool {
  if (!isValidAttrName(name)) {
    return false;
  }
  const l = asciiLower(name);
  if (l.startsWith("on") || l == "srcdoc" || l == "data-ou-on") {
    return false;
  }
  return true;
}

// Attributes whose value is a URL.
export function isUrlAttr(name: string): bool {
  const l = asciiLower(name);
  return l == "href" || l == "src" || l == "action" || l == "formaction" || l == "cite" || l == "poster"
    || l == "background" || l == "manifest" || l == "ping" || l == "data" || l == "longdesc" || l == "xlink:href";
}

// The value to store for the attribute: URL attributes are sanitised, all others are unchanged.
export function safeAttrValue(name: string, value: string): string {
  if (isUrlAttr(name)) {
    return safeUrl(value);
  }
  return value;
}

export function isVoidTag(t: string): bool {
  const l = asciiLower(t);
  return l == "area" || l == "base" || l == "br" || l == "col" || l == "embed" || l == "hr" || l == "img"
    || l == "input" || l == "link" || l == "meta" || l == "source" || l == "track" || l == "wbr";
}
